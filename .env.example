# ---------------------------------------------------------------------------
# SELFCURE PKS environment settings.
# Copy to .env for local development. On Azure, enter these as
# App Service > Settings > Environment variables (never commit real values).
# ---------------------------------------------------------------------------

APP_NAME="SELFCURE PKS"
# local for development, production on Azure
APP_ENV=local
# Generate with: php artisan key:generate --show
APP_KEY=
# true locally, false on Azure
APP_DEBUG=true
# Public address of the site, e.g. https://selfcure-pks.azurewebsites.net
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Locally: stack. On Azure: stderr (shows in App Service > Log stream).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Initial administrator (created once, on a new database, by `php artisan db:seed`).
# Change the password after the first login from the Profile page.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=zuhairzbn@gmail.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Database (MySQL). Locally: XAMPP. On Azure: Azure Database for MySQL
# Flexible Server, e.g. DB_HOST=yourserver.mysql.database.azure.com
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=selfcure_pks
DB_USERNAME=root
DB_PASSWORD=
# Azure MySQL requires TLS. On Azure App Service set:
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------------------
# AI assistant (Google Gemini). Free key: https://aistudio.google.com/apikey
# Without a key the result page falls back to the rule-based summary.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Sessions, cache and queue use the database (no extra services needed).
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on Azure (HTTPS only)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Email: two-factor codes and password-reset links.
# Locally "log" writes emails to storage/logs/laravel.log.
# On Azure use a real SMTP account, e.g. Gmail with an App Password:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
